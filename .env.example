# Groq API key for Llama 3.3 70B. Add the real key to .env.local, never here.
# Create or rotate a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Database URL for Prisma ORM
DATABASE_URL="******localhost:5432/karate_analytics?schema=public"

# Next.js Server Port (Optional)
PORT=3000
